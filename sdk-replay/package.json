{
  "name": "@celestialsynthesis/flowr-sdk-replay",
  "version": "0.1.1",
  "description": "FlowR guided-replay SDK — embed in-page replays of FlowR recordings without the browser extension.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Celestial-Synthesis/flowr-web-sdk.git",
    "directory": "sdk-replay"
  },
  "homepage": "https://github.com/Celestial-Synthesis/flowr-web-sdk/tree/main/sdk-replay",
  "bugs": {
    "url": "https://github.com/Celestial-Synthesis/flowr-web-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
